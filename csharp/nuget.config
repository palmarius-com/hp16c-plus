<?xml version="1.0" encoding="utf-8"?>
<!-- Packages this solution needs from nuget.org. Merged with the user's own
     NuGet configuration; with package source mapping switched on, only
     these patterns (plus the user's own) resolve from nuget.org. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Avalonia" />
      <package pattern="Avalonia.*" />
      <package pattern="SkiaSharp" />
      <package pattern="SkiaSharp.*" />
      <package pattern="HarfBuzzSharp" />
      <package pattern="HarfBuzzSharp.*" />
      <package pattern="MicroCom.Runtime" />
      <package pattern="Tmds.DBus.Protocol" />
      <!-- Microsoft's runtime packs, for dotnet publish -r <platform> -->
      <package pattern="Microsoft.NETCore.App.Runtime.*" />
      <package pattern="Microsoft.NETCore.App.Host.*" />
      <package pattern="Microsoft.NET.ILLink.Tasks" />
      <package pattern="Microsoft.WindowsDesktop.App.Runtime.*" />
      <package pattern="Microsoft.AspNetCore.App.Runtime.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

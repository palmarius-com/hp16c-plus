<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VoyagerSim</AssemblyName>
    <Version>0.3.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\*.md" LogicalName="Docs.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="App.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nut.Core\Nut.Core.csproj" />
  </ItemGroup>

</Project>

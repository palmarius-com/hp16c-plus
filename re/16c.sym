# HP-16C ROM symbols and comments (ours; the ROM itself is not in git).
# Format: addr label ; comment   (label "-" = comment only)
# "@data lo-hi" in a comment marks a data region (printed as dw).
# Listing: python -m nut.disasm nonpareil/16c.rom --sym re/16c.sym -o build/16c.lst
#          (run from the repository root)

# --- wake-up and main loop
0000 WAKE              ; power-on / wake-up entry (pc=0 after powoff or reset)
0089 MAIN_RET          ; return address pushed by FN_DISPATCH: routines rtn here

# --- stack primitives (touch RAM 0x00-0x03, 0x07 and M); 16C+ hook candidates
039b SAVE_LASTX        ; LSTx <- X (RAM4 copy -> RAM3, X high byte -> RAM7 LSTx byte); from MAIN_RET
0394 CLR_ENTRY         ; clear digit-entry state bits in RAM6 (rcr 8, pt=1, c=0 wp)
0646 SET_X_KEEP        ; b=a, m=c: X <- C, then falls into 0648
0648 GET_XHI           ; C <- RAM7, A.x <- X high byte, C <- N
064e PUT_XHI           ; n=c; X high byte from A.x into RAM7
0653 F_ROLL_HELPER     ; used by R^, Rv (0c00-0c04) and 0ea3
065e F_SWAP_HELPER     ; used by x<>y (0c07) and 0def
0be4 CLR_XHI           ; N=0, X high byte in RAM7 = 0
0bf2 GET_LASTX_HI      ; LSTx high byte (RAM7 >> 3 digits) -> A.x, then RAM0 (Y)
0e51 STACK_DROP        ; X <- C (m=c), Y <- Z, Z <- T, high bytes shifted in RAM7
0e68 STACK_LIFT        ; T <- Z, Z <- Y, Y <- X (N), high bytes shifted in RAM7
175c FLOAT_CLR_STACK   ; part of float conversion: Z, T, LSTx and high bytes cleared

# --- digit entry, registers, display, other W-dependent code
0c84 DIGIT_KEY         ; digit keys, A.x = digit; s12 = 0 (integer) -> 0b67, float -> 0c87
0b67 DIGIT_INT         ; integer digit entry (split per base at 0b6a)
0b72 DIGIT_HEX         ; integer entry: shift a nibble into X (M); OCT 0b8f, DEC 0b97 (x10 via 13a1)
0bd6 DIGIT_CHECK       ; digit < base?
0ba4 DIGIT_LIMIT       ; word-size overflow checks of the entry, digit count in G
08fa RCL_N             ; RCL n: CLR_ENTRY, REG_READ, STACK_LIFT
0914 STO_N             ; STO n: REG_WRITE
10dd REG_READ          ; storage register n -> C (nibble array at 0xE0, k = ceil(W/4))
1128 REG_WRITE         ; X -> storage register n
1076 DISPLAY           ; called from the main loop (00a8); formats X via 0986
0986 DISP_FORMAT       ; display formatting (integer bases and float)
01cd MEM_SHOW          ; MEM: P-n r-rrr
136f STATUS_SHOW       ; STATUS: complement-word size-flags
118a I_WRITE           ; X -> I (68-bit extension), used by STO I / X<>I
111d I_READ            ; I -> X (truncate to W), used by RCL I

1400 BSP_KEY           ; backspace: s7 = 0 -> 0c40 clear X, else 1403 per base
0c40 BSP_CLEAR         ; clear X like CLx (lift disabled)

# --- function dispatch (codes A1..EF)
082e FN_DISPATCH0      ; s0 (program mode) set -> 04d7
0833 FN_DISPATCH       ; A.x = function code; s12 := FLOAT mode (RAM6 digit 13)
0847 -                 ; codes < 0A1 -> 089a (other key handling)
084c -                 ; index = code - 0A1; table addr = 0400 + 2*index
0854 -                 ; cxisa: word 1 = routine offset -> B.x
0857 -                 ; cxisa: word 2 = program/display code -> A.x
0867 -                 ; s0 (program mode): store the code instead of executing
0874 -                 ; ? c#0 m -> gosub 0394 (clear entry state in RAM6)
0878 -                 ; push 0089 (return to main loop)
087c FN_PUSH_TARGET    ; push 0C00 + word1 = routine address. HOOK POINT for 16C+
0882 -                 ; s12 (float): set dec
0886 -                 ; gosub 0581, 0648 (operand set-up), save mode bits in RAM6
0891 -                 ; rtn -> routine (0C00 + word1)
0892 FN_LOW_CODES      ; codes below 0A1 (digits, prefixes, ...)
0400 FNTAB             ; function table, 2 words per code A1..EF ; @data 0400-049d

# --- function routines (0C00 + word1); generated by tools/fntable16c.py
0c00 F_RUP             ; fn code A5, table 0408, w2 0d3, RUP (code B0: empty entry, w1=w2=0)
0c04 F_RDN             ; fn code C5, table 0448, w2 033, RDN
0c07 F_X_EX_Y          ; fn code CA, table 0452, w2 034, X<>Y
0c0a F_CLRREG          ; fn code BA, table 0432, w2 284, CLRREG
0c18 F_LSTX            ; fn code A6, table 040a, w2 0d6, LSTX
0c21 F_ENTER           ; fn code C6, table 044a, w2 036, ENTER
0c28 F_RTN             ; fn code D4, table 0466, w2 2c1, RTN
0c42 F_CLX             ; fn code C0, table 043e, w2 0d5, CLX
0c53 F_R_S             ; fn code C8, table 044e, w2 231, R/S
0c64 F_PSE             ; fn code AA, table 0412, w2 2d4, PSE
0c77 F_CODE_C9         ; fn code C9, table 0450, w2 24e, unidentified
0cb0 F_CHS             ; fn code CB, table 0454, w2 049, CHS
0cf1 F_EEX             ; fn code BB, table 0434, w2 29f, EEX
0d55 F_SQRT            ; fn code A3, table 0404, w2 0c5, SQRT
0d7f F_SUB             ; fn code CD, table 0458, w2 030, -
0d82 F_ADD             ; fn code CC, table 0456, w2 040, +
0d9d F_ABS             ; fn code D8, table 046e, w2 0a8, ABS
0dae F_DBLR            ; fn code D9, table 0470, w2 1a9, DBLR
0daf F_DBLDIV          ; fn code AF, table 041c, w2 1b0, DBL/
0db1 F_DIV             ; fn code CF, table 045c, w2 010, /
0dbc F_INV             ; fn code A4, table 0406, w2 0cc, 1/X
0dc2 F_RMD             ; fn code E9, table 0490, w2 159, RMD
0dce F_MUL             ; fn code CE, table 045a, w2 020, *
0dde F_DBLMUL          ; fn code AE, table 041a, w2 1c0, DBLX
0df5 F_SCROLL_L        ; fn code A8, table 040e, w2 3e4, <
0dfc F_DEC             ; fn code C2, table 0442, w2 024, DEC
0dfe F_BIN             ; fn code C4, table 0446, w2 026, BIN
0dff F_OCT             ; fn code C3, table 0444, w2 025, OCT
0e00 F_HEX             ; fn code C1, table 0440, w2 023, HEX
0e09 F_SCROLL_R        ; fn code A7, table 040c, w2 3e5, >
0e0f F_TWOS            ; fn code E2, table 0482, w2 052, 2S
0e10 F_ONES            ; fn code E1, table 0480, w2 051, 1S
0e11 F_UNSGN           ; fn code E3, table 0484, w2 053, UNSGN
0e18 F_SB              ; fn code E4, table 0486, w2 154, SB
0e1a F_OR              ; fn code BC, table 0436, w2 190, OR
0e1f F_NOT             ; fn code BD, table 0438, w2 180, NOT
0e24 F_CB              ; fn code E5, table 0488, w2 155, CB
0e2b F_BTEST           ; fn code E6, table 048a, w2 156, B?
0e37 F_XOR             ; fn code BF, table 043c, w2 160, XOR
0e4b F_AND             ; fn code BE, table 043a, w2 170, AND
0e82 F_WSIZE           ; fn code B8, table 042e, w2 194, WSIZE
0eae F_ASR             ; fn code DB, table 0474, w2 1ab, ASR
0eb0 F_SR              ; fn code EB, table 0494, w2 15b, SR
0eb3 F_SL              ; fn code EA, table 0492, w2 15a, SL
0eb6 F_RRC             ; fn code DD, table 0478, w2 1ad, RRC
0eb7 F_RR              ; fn code ED, table 0498, w2 15d, RR
0ebb F_RLC             ; fn code DC, table 0476, w2 1ac, RLC
0ebc F_RL              ; fn code EC, table 0496, w2 15c, RL
0ed6 F_RLN             ; fn code EE, table 049a, w2 15e, RLN
0ed8 F_RLCN            ; fn code DE, table 047a, w2 1ae, RLCN
0ed9 F_RRCN            ; fn code DF, table 047c, w2 1af, RRCN
0eda F_RRN             ; fn code EF, table 049c, w2 15f, RRN
0eee F_LJ              ; fn code DA, table 0472, w2 1aa, LJ
0f12 F_MASKL           ; fn code E7, table 048c, w2 157, MASKL
0f13 F_MASKR           ; fn code E8, table 048e, w2 158, MASKR
0f2f F_SHOWDEC         ; fn code B2, table 0422, w2 374, SHOWDEC
0f31 F_SHOWBIN         ; fn code B4, table 0426, w2 376, SHOWBIN
0f32 F_SHOWOCT         ; fn code B3, table 0424, w2 375, SHOWOCT
0f33 F_SHOWHEX         ; fn code B1, table 0420, w2 373, SHOWHEX
0f53 F_X_EX_IND_I      ; fn code B9, table 0430, w2 071, X<>(I)
0f68 F_X_LE_Y          ; fn code D1, table 0460, w2 2a1, X<=Y
0f6c F_X_GT_0          ; fn code AD, table 0418, w2 2d0, X>0
0f71 F_X_NE_Y          ; fn code D0, table 045e, w2 2a0, X#Y
0f74 F_X_NE_0          ; fn code A9, table 0410, w2 2e8, X#0
0f7c F_X_GT_Y          ; fn code D3, table 0464, w2 2a3, X>Y
0f7f F_X_LT_0          ; fn code D2, table 0462, w2 2a2, X<0
0f85 F_X_EQ_Y          ; fn code AB, table 0414, w2 2e9, X=Y
0f88 F_X_EQ_0          ; fn code AC, table 0416, w2 2e0, X=0
0f8d F_GTO_I           ; fn code B7, table 042c, w2 2f6, GTO I
0f8e F_GSB_I           ; fn code C7, table 044c, w2 2f5, GSB I
0f99 F_I               ; fn code B6, table 042a, w2 0f9, I
0fa0 F_X_EX_I          ; fn code E0, table 047e, w2 072, X<>I
0fab F_IND_I           ; fn code B5, table 0428, w2 0f4, (I)
0fb1 F_STO_IND         ; fn code D5, table 0468, w2 2f3, STO (i)
0fb8 F_STO_I           ; fn code D6, table 046a, w2 2f8, STO I
0fbe F_ISZ             ; fn code A2, table 0402, w2 2c4, ISZ
0fbf F_DSZ             ; fn code A1, table 0400, w2 2c3, DSZ
0fe2 F_NBITS           ; fn code D7, table 046c, w2 1a7, #B
# function entry and exit
008b MAIN_NOLX         ; main loop after the LSTx save: N = C, X byte = A.x (masked to W)
0581 FN_MODEBITS       ; s7 = 1's complement, s8 = unsigned (complement mode from RAM 6)
03b2 SET_FLAG_C        ; flag 4 <- s10 (RAM select 0; keeps A, C)
03bf SET_FLAG_G        ; flag 5 <- s13
03c2 SET_FLAGS_CG      ; flag 4 <- s10, flag 5 <- s13
